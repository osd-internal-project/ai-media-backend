generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["interactiveTransactions"]
  binaryTargets   = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LogSeverity {
  INFO
  WARN
  ERROR
  FATAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  DOWNLOAD
  // เพิ่ม action อื่นๆ ตามต้องการ
}

model users {
  id                   Int                  @id @default(autoincrement())
  userId               String               @unique @default(uuid()) @db.VarChar(50)
  username             String               @unique @db.VarChar(100)
  fullname             String               @db.VarChar(200)
  email                String               @db.VarChar(200)
  tier                 String               @default("free") @db.VarChar(200)
  description          String?              @db.Text
  phoneNumber          String               @default("phone_number") @db.VarChar(50)
  status               String               @default("active") @db.VarChar(50) //active, inactive, deleted, banned, invite
  lastOn               DateTime?            @map("last_on")
  maxToken             Int?                 @default(0)
  maxImages            Int?                 @default(0) @map("max_images")
  apiKeys              String?              @map("api_keys") @db.Text
  token                String?              @db.VarChar(50)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  agreement            Boolean              @default(false)
  role                 String?              @default("USER") @db.VarChar(50)
  groups               UserGroup[]
  projectMembers       ProjectMember[]
  galleries            Gallery[]
  logs                 Log[]
  recentOrganizationId String?              @map("recent_organization_id") @db.VarChar(50)
  organizationMembers  OrganizationMember[]
}

model Project {
  id                   String          @id @default(uuid())
  name                 String
  description          String?
  createdAt            DateTime        @default(now())
  status               String?         @default("active") @db.VarChar(10)
  // Relations
  members              ProjectMember[]
  galleries            Gallery[]
  logs                 Log[]
  organizationId       String?         @map("organization_id") @db.VarChar(50)
  // ยอดจำกัด ของ Project
  limitImageAllowance  Int             @default(0) @map("limit_image_allowance")
  limitCreditAllowance Float           @default(0) @map("limit_credit_allowance")
  // ยอดใช้ของ Project
  usedImageAllowance   Int             @default(0) @map("used_image_allowance")
  usedCreditAllowance  Float           @default(0) @map("used_credit_allowance")
  // ยอดจัดเก็บของ Project
  holdImageAllowance   Int             @default(0) @map("hold_image_allowance")
  holdCreditAllowance  Float           @default(0) @map("hold_credit_allowance")
  //ตัวเก่า
  accessTokenAmount    Int?            @default(0) @map("access_token_amount")
  accessImageAmount    Int?            @default(0) @map("access_image_amount")
  remainTokenAmount    Int?            @default(0) @map("remain_token_amount")
  remainImageAmount    Int?            @default(0) @map("remain_image_amount")

  @@map("project")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String?
  joinedAt  DateTime @default(now())

  project              Project @relation(fields: [projectId], references: [id])
  users                users   @relation(fields: [userId], references: [userId])
  // ยอดจำกัด ของ ProjectMember
  limitImageAllowance  Int?    @default(0) @map("limit_image_allowance")
  limitCreditAllowance Float?  @default(0) @map("limit_credit_allowance")
  // ยอดใช้ของ ProjectMember
  usedImageAllowance   Int     @default(0) @map("used_image_allowance")
  usedCreditAllowance  Float   @default(0) @map("used_credit_allowance")
  // ยอดจัดเก็บของ ProjectMember
  holdImageAllowance   Int     @default(0) @map("hold_image_allowance")
  holdCreditAllowance  Float   @default(0) @map("hold_credit_allowance")
  // ตัวเก่า
  maxToken             Int?    @default(0) @map("max_token")
  maxImages            Int?    @default(0) @map("max_images")

  @@unique([projectId, userId]) // ห้ามซ้ำ
  @@map("project_member")
}

model Gallery {
  id               String   @id @default(uuid())
  taskId           String?
  projectId        String
  userId           String
  imageUrl         String?
  prompt           String?
  thumbnailUrl     String?
  typeGenerate     String?
  createdAt        DateTime @default(now())
  status           Boolean? @default(false)
  project          Project  @relation(fields: [projectId], references: [id])
  users            users    @relation(fields: [userId], references: [userId])
  genneratedStatus String?  @default("PENDING") @db.VarChar(50)
  generateConfig   Json?    @map("generate_config") @db.JsonB
  usedCredit       Float?   @default(0) @map("used_credit")
  usedImage        Int?     @default(0) @map("used_image")

  @@map("gallery")
}

model Log {
  id              String   @id @default(uuid())
  taskId          String?
  status          String?
  typeGenerate    String?
  projectId       String
  userId          String
  prompt          String
  tokenUsed       Float
  ImageUsed       Int
  referenceImages String[] @default([])
  resolution      String?
  ratio           String?
  generateAudio   Boolean? @default(false)
  createdAt       DateTime @default(now())
  generateConfig  Json?    @map("generate_config") @db.JsonB
  project         Project  @relation(fields: [projectId], references: [id])
  users           users    @relation(fields: [userId], references: [userId])
  galleryId       String?  @map("gallary_id") @db.VarChar(100)
  usedCredit      Float?   @default(0) @map("used_credit")
  usedImage       Int?     @default(0) @map("used_image")

  @@map("log")
}

model groups {
  id          Int      @id @default(autoincrement())
  groupId     String   @unique @default(uuid()) @map("group_id") @db.VarChar(50)
  name        String   @db.VarChar(100)
  displayName String?  @map("display_name") @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles GroupRole[]
  users UserGroup[]
}

model role {
  id          Int      @id @default(autoincrement())
  roleId      String   @unique @default(uuid()) @map("role_id") @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  type        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  groups GroupRole[]
}

model GroupRole {
  id Int @id @default(autoincrement())

  groupId String @db.VarChar(50)
  roleId  String @db.VarChar(50)

  group groups @relation(fields: [groupId], references: [groupId])
  role  role   @relation(fields: [roleId], references: [roleId])

  createdAt DateTime @default(now())

  @@unique([groupId, roleId])
  @@map("group_role")
}

model UserGroup {
  id      Int    @id @default(autoincrement())
  userId  String @db.VarChar(50)
  groupId String @db.VarChar(50)
  users   users  @relation(fields: [userId], references: [userId])
  group   groups @relation(fields: [groupId], references: [groupId])

  createdAt DateTime @default(now())

  @@unique([userId, groupId])
  @@map("user_group")
}

model MasterModelType {
  id           Int      @unique @default(autoincrement()) @map("id")
  modelType    String?  @map("model_type") @db.VarChar(150)
  type         String?  @map("type") @db.VarChar(150)
  description  String?  @map("description") @db.VarChar(150)
  isDefault    Boolean  @default(false) @map("is_default")
  modelDetails Json?    @map("model_details")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@map("master_model_type")
}

model GenerateImage {
  id        Int       @unique @default(autoincrement()) @map("id")
  fileName  String?   @map("file_name") @db.VarChar(150)
  filePath  String?   @map("file_path") @db.VarChar(150)
  fileType  String?   @map("file_type") @db.VarChar(150)
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @map("updated_at")

  @@map("generate_image")
}

model HistoryLogsImages {
  id        Int      @unique @default(autoincrement()) @map("id")
  userId    String?  @map("user_id") @db.VarChar(50)
  token     String?  @map("token") @db.VarChar(50)
  modelType String?  @map("model_type") @db.VarChar(150)
  imageId   String?  @map("image_id") @db.VarChar(150)
  status    String?  @map("status") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("history_logs_images")
}

model MasterDataConfigApi {
  id               Int      @unique @default(autoincrement()) @map("id")
  configType       String?  @map("config_type") @db.VarChar(150)
  authorization    String?  @map("authorization") @db.VarChar(150)
  apiCreateImage   String?  @map("api_create_image") @db.VarChar(250)
  apiCreateTaskVdo String?  @map("api_update_task_vdo") @db.VarChar(250)
  maxImage         Int?     @map("max_image") @db.Integer
  watermark        Boolean? @map("watermark") @db.Boolean
  stream           Boolean? @map("stream") @db.Boolean
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @map("updated_at")

  @@map("master_data_config_api")
}

model PromptGuide {
  id                Int              @unique @default(autoincrement()) @map("id")
  title             String?          @map("title") @db.VarChar(150)
  textPrompt        String?          @map("text_prompt") @db.Text
  status            Boolean          @map("status") @db.Boolean
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @default(now()) @map("updated_at")
  promptGuideType   PromptGuideType? @relation(fields: [promptGuideTypeId], references: [id])
  promptGuideTypeId Int?             @map("prompt_guide_type_id")
  organizationId    String?          @map("organization_id") @db.VarChar(50)
  generateType      String           @default("image") @map("generate_type") @db.VarChar(10) // image/video
  promptGuideImages String[]         @default([]) @map("prompt_guide_images")

  @@map("prompt_guide")
}

model PromptGuideImage {
  id            Int      @id @default(autoincrement())
  uid           String   @unique @db.VarChar(50)
  userId        String   @map("user_id") @db.VarChar(50)
  index         Int      @default(0)
  imageName     String   @map("image_name") @db.VarChar(200)
  imagePath     String   @map("image_path") @db.VarChar(200)
  imageType     String   @map("image_type") @db.VarChar(50)
  imageSize     Int      @default(0) @map("image_size")
  generateType  String   @map("generate_type") @db.VarChar(50)
  status        String   @default("waiting") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  // promptGuide   PromptGuide? @relation(fields: [promptGuideId], references: [id])
  promptGuideId Int?     @map("prompt_guide_id") @db.Integer()

  @@map("prompt_guide_images")
}

model PromptGuideType {
  id             Int           @unique @default(autoincrement()) @map("id")
  title          String?       @map("title") @db.VarChar(150)
  status         Boolean       @map("status") @db.Boolean
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @map("updated_at")
  organizationId String?       @map("organization_id") @db.VarChar(50)
  promptGuide    PromptGuide[]
  generateType   String        @default("image") @map("generate_type") @db.VarChar(10) // image/video

  @@map("prompt_guide_type")
}

model OmnihumenTask {
  id            Int      @unique @default(autoincrement()) @map("id")
  uuid          String?  @default(uuid()) @map("uuid") @db.VarChar(50)
  status        Boolean  @map("status") @db.Boolean
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  taskId        String   @map("task_id") @db.VarChar(100)
  taskRequestId String?  @map("task_request_id") @db.VarChar(100)
  taskMessage   String?  @map("task_message") @db.VarChar(20)
  fileId        String?  @map("file_id") @db.VarChar(100)
  filePath      String?  @map("file_path") @db.Text
  fileOrgPath   String?  @map("file_org_path") @db.Text
  projectId     String   @map("project_id") @db.VarChar(100)
  userId        String?  @map("user_id") @db.VarChar(100)
  avatarName    String?  @map("avatar_name") @db.VarChar(150)
  prompt        String?  @map("prompt") @db.Text
  taskCode      String?  @map("task_code") @db.VarChar(20)

  @@map("omnihumen_task")
}

model Organization {
  id             Int     @unique @default(autoincrement()) @map("id")
  organizationId String  @unique @default(uuid()) @map("organization_id") @db.VarChar(50)
  name           String  @map("name") @db.VarChar(150)
  slug           String  @map("slug") @db.VarChar(150)
  description    String? @map("description") @db.Text
  type           String  @map("type") @db.VarChar(50) // "PERSONAL | TEAM"
  status         Boolean @default(true) @map("status") @db.Boolean

  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  organizationMember OrganizationMember[]
  createdById        String               @map("created_by") @db.VarChar(50)
  updatedById        String?              @map("updated_by") @db.VarChar(50)
  invitations        Invitation[]

  packageTokenAmount  Int?                      @map("package_token_amount")
  packageImageAmount  Int?                      @map("package_image_amount")
  remainTokenAmount   Int?                      @default(0) @map("remain_token_amount")
  remainImageAmount   Int?                      @default(0) @map("remain_image_amount")
  maxUserAccess       Int?                      @map("max_user_access")
  subscription        OrganizationSubscription?
  creditBalance       CreditBalance?
  packageTransactions PackageTransaction[]

  @@map("organization")
}

model OrganizationSubscription {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @map("organization_id") @db.VarChar(50)
  organization   Organization @relation(fields: [organizationId], references: [organizationId])

  planId             String   @map("plan_id") @db.Uuid
  plan               Plan     @relation(fields: [planId], references: [id])
  // --- Snapshot ข้อมูล Package ณ รอบปัจจุบัน ---
  planName           String   @default("") @map("plan_name") // เช่น "Pro Plan"
  price              Decimal  @default(0) @map("price") @db.Decimal(10, 2)
  interval           String?  @map("interval") @db.VarChar(50)
  creditAllowance    Float    @default(0) @map("credit_allowance") // โควตาของรอบนี้
  imageAllowance     Float    @default(0) @map("image_allowance")
  // จัดการรอบบิล: เมื่อถึง End Date คือวันที่ต้อง Reset Credit (Use-it-or-lose-it)
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  nextBillingDate    DateTime @map("next_billing_date")
  nextPlanId         String?  @map("next_plan_id") @db.Uuid
  nextPlanPriceId    String?  @map("next_plan_price_id") @db.Uuid
  autoRenew          Boolean  @default(true) @map("auto_renew")
  status             String   @default("active") @map("status")
  period             String   @default("monthly") @map("period")
  periodCount        Int      @default(1) @map("period_count")
  periodCurrent      Int      @default(1) @map("period_current")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("organization_subscriptions")
}

model OrganizationMember {
  id             Int          @unique @default(autoincrement()) @map("id")
  userId         String       @map("user_id") @db.VarChar(50)
  organizationId String       @map("organization_id") @db.VarChar(50)
  role           String       @map("role") @db.VarChar(50) //"OWNER | ADMIN | MEMBER | VIEWER"
  joinedAt       DateTime     @default(now()) @map("joined_at")
  organization   Organization @relation(fields: [organizationId], references: [organizationId])

  apiKeys   String? @map("api_keys") @db.Text
  users     users   @relation(fields: [userId], references: [userId])
  maxToken  Int?
  maxImages Int?    @default(0) @map("max_images")

  @@unique([organizationId, userId])
  @@map("organization_member")
}

model CreditBalance {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @unique @map("organization_id") @db.VarChar(50)
  organization        Organization @relation(fields: [organizationId], references: [organizationId])
  // ยอด hold กรณี task ยังไม่ success
  holdBalance         Float        @default(0) @map("hold_balance")
  holdImage           Float        @default(0) @map("hold_image")
  // ยอดเครดิตประจำรอบปัจจุบัน (จะ Reset เมื่อเปลี่ยนรอบบิล) 
  currentCycleBalance Float        @default(0) @map("current_cycle_balance")
  currentCycleImage   Float        @default(0) @map("current_cycle_image")

  // เครดิตที่ซื้อเพิ่ม (On-top) ไม่หายเมื่อขึ้นรอบใหม่
  onTopBalance Float @default(0) @map("on_top_balance")
  onTopImage   Float @default(0) @map("on_top_image")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("credit_balances")
}

model Invitation {
  id             String   @id @default(uuid())
  email          String   @db.VarChar(200)
  organizationId String   @map("organization_id") @db.VarChar(50)
  role           String   @default("MEMBER") @db.VarChar(50) // Matches OrganizationMember role
  token          String   @unique @db.VarChar(100)
  expiresAt      DateTime @map("expires_at")
  status         String   @default("PENDING") @db.VarChar(20) // PENDING, ACCEPTED, EXPIRED
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [organizationId])

  @@index([email])
  @@map("invitation")
}

model RequestChangePassword {
  id        String   @id @default(uuid())
  username  String   @db.VarChar(200)
  email     String   @db.VarChar(200)
  token     String   @unique @db.VarChar(100)
  expiresAt DateTime @map("expires_at")
  status    String   @default("PENDING") @db.VarChar(20) // PENDING, ACCEPTED, EXPIRED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([id])
  @@map("request_change_password")
}

model ErrorLog {
  id          BigInt      @id @default(autoincrement())
  serviceName String      @map("service_name") @db.VarChar(50)
  environment String      @default("development") @db.VarChar(20)
  severity    LogSeverity
  errorCode   String?     @map("error_code") @db.VarChar(50)
  message     String      @db.Text
  stackTrace  String?     @map("stack_trace") @db.Text
  context     Json?       @db.JsonB // Prisma รองรับ JSONB
  userId      String?     @map("user_id") @db.VarChar(50)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([serviceName, severity])
  @@index([createdAt])
  @@map("error_logs") // ชื่อตารางจริงใน DB
}

model AuditLog {
  id         BigInt      @id @default(autoincrement())
  userId     String      @map("user_id") @db.VarChar(50)
  action     AuditAction
  entityName String      @map("entity_name") @db.VarChar(50)
  entityId   String      @map("entity_id") @db.VarChar(50)
  oldValues  Json?       @map("old_values") @db.JsonB
  newValues  Json?       @map("new_values") @db.JsonB
  ipAddress  String?     @map("ip_address") @db.Inet // Map INET เป็น String ใน JS
  userAgent  String?     @map("user_agent") @db.Text
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityName, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs") // ชื่อตารางจริงใน DB
}

model Plan {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  description String? @db.Text
  badge       String? @db.VarChar(50)
  isPopular   Boolean @default(false) @map("is_popular")
  borderColor String? @map("border_color") @db.VarChar(50)
  isDefault   Boolean @default(false) @map("is_default")
  detailJson  Json?   @map("detail_json") @db.JsonB

  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscriptions OrganizationSubscription[]
  prices        PlanPrice[]
  features      PlanFeature[]
  status        Boolean                    @default(false)
  orderIndex    Int                        @default(0) @map("order_index")

  @@map("plans")
}

model PlanPrice {
  id              String  @id @default(uuid()) @db.Uuid
  planId          String  @map("plan_id") @db.Uuid
  plan            Plan    @relation(fields: [planId], references: [id])
  interval        String  @default("MONTH") @db.VarChar(20) // MONTH | YEAR
  price           Decimal @db.Decimal(10, 2)
  duration        Int     @default(0) @map("duration")
  creditAllowance Float   @default(0.00) @map("credit_allowance")
  imageAllowance  Float   @default(0.00) @map("image_allowance")
  currency        String  @default("THB") @db.VarChar(3)
  isDefault       Boolean @default(false) @map("is_default")
  orderIndex      Int     @default(0) @map("order_index")
  detail          Json?   @map("detail") @db.JsonB
  periodCount     Int     @default(1) @map("period_count")
  periodUnit      String? @db.VarChar(20)

  // @@unique([])
  @@map("plan_prices")
}

model PackageTransaction {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.VarChar(50)
  organization       Organization @relation(fields: [organizationId], references: [organizationId])
  amountPaid         Decimal      @db.Decimal(10, 2)
  currency           String       @default("THB")
  status             String       @default("WAIT")
  paymentMethod      String?      @map("payment_method")
  paidAt             DateTime?    @map("paid_at") // วันที่จ่ายเงินจริง 
  expiredPaymentAt   DateTime?    @map("expired_payment_at") // วันที่หมดอายุ 
  // --- ข้อมูล Package ที่ซื้อใน Transaction นี้ ---
  planId             String?      @map("plan_id") @db.VarChar(50)
  planName           String       @map("plan_name") @db.VarChar(50)
  planInterval       String       @map("plan_interval") @db.VarChar(20)
  // บันทึกว่าการจ่ายเงินนี้ครอบคลุมช่วงเวลาไหน
  billingPeriodStart DateTime     @map("billing_period_start")
  billingPeriodEnd   DateTime     @map("billing_period_end")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("package_transactions")
}

model Feature {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(50)
  label     String   @db.VarChar(100)
  icon      String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  planFeatures PlanFeature[]

  @@map("features")
}

model PlanFeature {
  id        String @id @default(uuid()) @db.Uuid
  planId    String @map("plan_id") @db.Uuid
  featureId String @map("feature_id") @db.Uuid

  plan    Plan    @relation(fields: [planId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  value       String  @db.Text
  isHighlight Boolean @default(false) @map("is_highlight")
  orderIndex  Int     @default(0) @map("order_index")
  category    String? @default("General") @db.VarChar(100)

  @@unique([planId, featureId])
  @@map("plan_features")
}

model Register {
  id          Int      @id @default(autoincrement())
  username    String   @db.VarChar(100)
  email       String   @db.VarChar(200)
  fullname    String   @db.VarChar(200)
  phoneNumber String?  @map("phone_number") @db.VarChar(50)
  token       String   @unique @db.VarChar(100)
  agreement   Boolean  @default(false)
  isVerify    Boolean  @default(false) @map("is_verify")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("registers")
}

model RefImage {
  id           Int      @id @default(autoincrement())
  uid          String   @unique @db.VarChar(50)
  userId       String   @map("user_id") @db.VarChar(50)
  index        Int      @default(0)
  projectId    String   @map("project_id") @db.VarChar(100)
  imageName    String   @map("image_name") @db.VarChar(200)
  imagePath    String   @map("image_path") @db.VarChar(200)
  imageType    String   @map("image_type") @db.VarChar(50)
  imageSize    Int      @default(0) @map("image_size")
  generateType String   @map("generate_type") @db.VarChar(50)
  status       String   @default("waiting") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("ref_images")
}
