<!DOCTYPE html>
<html>

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Ai Cave</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #ffffff;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            color: #111827;
        }

        .container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            text-align: center;
            padding: 40px 20px;
        }

        .logo {
            margin-bottom: 30px;
            font-size: 32px;
            font-weight: bold;
            color: #111827;
            /* Placeholder styling for "Ai Cave" text logo if image unavailable */
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .logo-text {
            font-family: 'Courier New', Courier, monospace;
            /* Tech feel for AI Cave */
            letter-spacing: -1px;
        }

        h1 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 10px;
            line-height: 1.3;
        }

        p.subtitle {
            font-size: 16px;
            color: #4b5563;
            margin-bottom: 30px;
        }

        .account-box {
            background-color: #f9fafb;
            border-radius: 8px;
            padding: 24px;
            margin-bottom: 30px;
            text-align: center;
        }

        .account-label {
            font-size: 14px;
            font-weight: 600;
            color: #111827;
            margin-bottom: 5px;
        }

        .account-email {
            font-size: 16px;
            color: #000080;
            /* Green color from image */
            font-weight: 500;
            text-decoration: none;
        }

        .btn {
            display: inline-block;
            background-color: #000080;
            /* Green color matching image */
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            padding: 14px 32px;
            border-radius: 6px;
            text-decoration: none;
            margin-bottom: 30px;
        }

        .btn:hover {
            background-color: #000060;
        }

        .fallback {
            font-size: 14px;
            color: #4b5563;
            margin-bottom: 10px;
            line-height: 1.5;
        }

        .fallback-link {
            color: #000080;
            text-decoration: none;
            word-break: break-all;
        }

        .footer {
            margin-top: 40px;
            font-size: 12px;
            color: #9ca3af;
            line-height: 1.5;
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- Logo Section -->
        <div class="logo">
            <span class="logo-text">Ai Cave</span>
        </div>

        <!-- Main Content -->
        <h1>Welcome to Ai Cave</h1>
        <p class="subtitle">An Ai Cave account has been created for you in <strong>{{teamName}}</strong>.</p>

        <!-- Account Info Box -->
        <div class="account-box">
            <div class="account-label">Username:</div>
            <div class="account-email">{{username}}</div>
            <div class="account-label" style="margin-top: 12px;">Email:</div>
            <div class="account-email">{{email}}</div>
        </div>

        <!-- Steps -->
        <ol style="text-align: left; max-width: 440px; margin: 0 auto 30px; padding-left: 20px; font-size: 15px; color: #374151; line-height: 1.7;">
            <li>Click the button below to set up your account (link valid for {{expires_in}}).</li>
            <li>Choose your Ai Cave password.</li>
            <li>Sign in at <a href="{{login_url}}" style="color: #000080;">{{login_url}}</a> with your username or email and the new password.</li>
        </ol>

        <!-- Action Button -->
        <a href="{{action_url}}" class="btn">Set up my account</a>

        <!-- Fallback Link -->
        <div class="fallback">
            Can’t click the button above?<br>
            Click or copy and paste this link into your browser.
        </div>
        <div style="text-align: center; margin-bottom: 20px;">
            <a href="{{action_url}}" class="fallback-link">{{action_url}}</a>
        </div>

        <!-- Footer -->
        <div class="footer">
            If you weren’t expecting this email, you can ignore it.<br>
            If you’re having any issues with your account, feel free to contact customer support or reach out via Ai
            Cave support.
        </div>
    </div>
</body>

</html>
