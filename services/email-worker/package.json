{
  "name": "@ai-media/email-worker",
  "description": "",
  "version": "1.0.3",
  "author": "",
  "dependencies": {
    "@ai-media/share": "0.0.1",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^9.1.6",
    "@nestjs/config": "^2.1.0",
    "@nestjs/core": "^9.1.2",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/microservices": "^9.0.0",
    "@nestjs/platform-express": "^9.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "handlebars": "^4.7.8",
    "nodemailer": "^7.0.3",
    "reflect-metadata": "^0.1.13",
    "bullmq": "^5.67.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.1.3",
    "@types/node": "^16.0.0",
    "@typescript-eslint/eslint-plugin": "^5.38.1",
    "@typescript-eslint/parser": "^5.38.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.24.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "29.0.3",
    "prettier": "^2.5.1",
    "ts-jest": "29.0.2",
    "ts-node": "^10.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "4.7.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "license": "UNLICENSED",
  "prisma": {
    "schema": "../../libs/prisma/schema.prisma",
    "seed": "yarn workspace @namecard/prisma db:seed"
  },
  "private": true,
  "scripts": {
    "build": "nest build",
    "db:pull": "yarn prisma db pull",
    "db:push": "yarn prisma db push",
    "db:seed": "yarn prisma db seed",
    "dev1": "cross-env NODE_ENV=local DATABASE_URL=postgresql://postgres:1010@localhost:5432/dev ts-node-dev --respawn --exit-child --transpile-only -r tsconfig-paths/register ./src/main.ts",
    "dev": "cross-env NODE_ENV=local ts-node-dev --respawn --exit-child --transpile-only -r tsconfig-paths/register ./src/main.ts ",
    "docker:build": "cd ../.. && docker build -t 'd-debt/email-worker' -f services/email-worker/Dockerfile .",
    "docker:buildx": "cd ../.. && docker build --no-cache --platform linux/amd64 -t 'ai-cave-email-worker:v1.0.1' -f services/email-worker/Dockerfile .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "generate": "prisma generate",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:reset": "prisma migrate reset",
    "prebuild": "rimraf dist",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:watch": "jest --watch"
  }
}