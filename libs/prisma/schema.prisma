generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["interactiveTransactions"]
  binaryTargets   = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id        Int      @unique @default(autoincrement())
  userId    String   @unique @default(uuid()) @map("user_id") @db.VarChar(50)
  username  String   @db.VarChar(100)
  password  String?
  fullname String?  @map("fullname") @db.VarChar(100)
  email     String?  @db.VarChar(100)
  phone     String?  @map("phone") @db.VarChar(20)
  status    Boolean  @default(true) @map("status")
  clientId  String?  @map("client_id") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  token     String?  @db.VarChar(50)
}

