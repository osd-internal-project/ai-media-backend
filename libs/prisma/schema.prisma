generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["interactiveTransactions"]
  binaryTargets   = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LogSeverity {
  INFO
  WARN
  ERROR
  FATAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  DOWNLOAD
  // เพิ่ม action อื่นๆ ตามต้องการ
}

model users {
  id                   Int                  @id @default(autoincrement())
  userId               String               @unique @default(uuid()) @map("user_id") @db.VarChar(50)
  username             String               @unique @db.VarChar(100)
  fullname             String               @db.VarChar(200)
  email                String               @db.VarChar(200)
  tier                 String               @default("free") @db.VarChar(200)
  description          String?              @db.Text
  phoneNumber          String               @default("phone_number") @map("phone_number") @db.VarChar(50)
  status               String               @default("active") @db.VarChar(50) //active, inactive, deleted, banned, invite
  lastOn               DateTime?            @map("last_on")
  maxToken             Int?                 @default(0) @map("max_token")
  maxImages            Int?                 @default(0) @map("max_images")
  apiKeys              String?              @map("api_keys") @db.Text
  token                String?              @db.VarChar(50)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  agreement            Boolean              @default(false)
  role                 String?              @default("USER") @db.VarChar(50)
  groups               UserGroup[]
  projectMembers       ProjectMember[]
  galleries            Gallery[]
  logs                 Log[]
  recentOrganizationId String?              @map("recent_organization_id") @db.VarChar(50)
  organizationMembers  OrganizationMember[]

  // index ตาม source/improvements P1-5 (query จริงใน services)
  @@index([token])
  @@index([email])
}

model Project {
  id                    String                 @id @default(uuid())
  name                  String
  description           String?
  createdAt             DateTime               @default(now()) @map("created_at")
  status                String?                @default("active") @db.VarChar(10)
  // Relations
  members               ProjectMember[]
  galleries             Gallery[]
  logs                  Log[]
  // ความสัมพันธ์กับ Workflow (เพิ่มใหม่ แบบ additive ไม่กระทบของเดิม)
  workflowConversations WorkflowConversation[]
  activityShares        ActivityShare[]
  communityPosts        CommunityPost[]
  photoEventTemplates   PhotoEventTemplate[]
  photoEventPhotos      PhotoEventPhoto[]
  printTemplates        PhotoEventPrintTemplate[]
  organizationId        String?                @map("organization_id") @db.VarChar(50)
  // ยอดจำกัด ของ Project
  limitImageAllowance   Int                    @default(0) @map("limit_image_allowance")
  limitCreditAllowance  Float                  @default(0) @map("limit_credit_allowance")
  // ยอดใช้ของ Project
  usedImageAllowance    Int                    @default(0) @map("used_image_allowance")
  usedCreditAllowance   Float                  @default(0) @map("used_credit_allowance")
  // ยอดจัดเก็บของ Project
  holdImageAllowance    Int                    @default(0) @map("hold_image_allowance")
  holdCreditAllowance   Float                  @default(0) @map("hold_credit_allowance")
  //ตัวเก่า
  accessTokenAmount     Int?                   @default(0) @map("access_token_amount")
  accessImageAmount     Int?                   @default(0) @map("access_image_amount")
  remainTokenAmount     Int?                   @default(0) @map("remain_token_amount")
  remainImageAmount     Int?                   @default(0) @map("remain_image_amount")

  @@map("project")

  // index ตาม source/improvements P1-5 (query จริงใน services)
  @@index([organizationId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String?
  joinedAt  DateTime @default(now()) @map("joined_at")

  project              Project @relation(fields: [projectId], references: [id])
  users                users   @relation(fields: [userId], references: [userId])
  // ยอดจำกัด ของ ProjectMember
  limitImageAllowance  Int?    @default(0) @map("limit_image_allowance")
  limitCreditAllowance Float?  @default(0) @map("limit_credit_allowance")
  // ยอดใช้ของ ProjectMember
  usedImageAllowance   Int     @default(0) @map("used_image_allowance")
  usedCreditAllowance  Float   @default(0) @map("used_credit_allowance")
  // ยอดจัดเก็บของ ProjectMember
  holdImageAllowance   Int     @default(0) @map("hold_image_allowance")
  holdCreditAllowance  Float   @default(0) @map("hold_credit_allowance")
  // ตัวเก่า
  maxToken             Int?    @default(0) @map("max_token")
  maxImages            Int?    @default(0) @map("max_images")

  @@unique([projectId, userId]) // ห้ามซ้ำ
  @@map("project_member")

  // index ตาม source/improvements P1-5 (query จริงใน services)
  @@index([userId])
}

model Gallery {
  id  String @id @default(uuid())
  seq Int    @default(autoincrement()) @db.Integer

  taskId           String?  @map("task_id")
  projectId        String   @map("project_id")
  userId           String   @map("user_id")
  imageUrl         String?  @map("image_url")
  prompt           String?
  thumbnailUrl     String?  @map("thumbnail_url")
  typeGenerate     String?  @map("type_generate")
  createdAt        DateTime @default(now()) @map("created_at")
  status           Boolean? @default(false)
  project          Project  @relation(fields: [projectId], references: [id])
  users            users    @relation(fields: [userId], references: [userId])
  genneratedStatus String?  @default("PENDING") @map("gennerated_status") @db.VarChar(50)
  generateConfig   Json?    @map("generate_config") @db.JsonB
  usedCredit       Float?   @default(0) @map("used_credit")
  usedImage        Int?     @default(0) @map("used_image")
  // คอลัมน์ใหม่สำหรับแยกประเภทฟีเจอร์ — มี default + nullable เพื่อไม่ให้ insert เดิมพัง
  featureType      String   @default("chat") @map("feature_type") @db.VarChar(50)
  refFeatureId     String?  @map("ref_feature_id") @db.VarChar(100)
  // คอลัมน์ที่ denormalize มาจาก log (metadata ระดับ request) — nullable/default เพื่อไม่ให้ insert เดิมพัง
  referenceImages  String[] @default([]) @map("reference_images")
  // เก็บ object name ของ output ทุกรูปใน generation เดียว (แทน imageUrl เดี่ยว) — default [] กัน data เก่า
  resultUrl        String[] @default([]) @map("result_url")
  resolution       String?
  ratio            String?
  generateAudio    Boolean? @default(false) @map("generate_audio")
  tokenUsed        Float?   @default(0) @map("token_used")
  ImageUsed        Int?     @default(0) @map("image_used")

  @@map("gallery")

  // index ตาม source/improvements P1-5 (query จริงใน services)
  @@index([projectId, typeGenerate, seq])
  @@index([taskId])
  @@index([userId])
}

model Log {
  id              String   @id @default(uuid())
  seq             Int      @default(autoincrement()) @db.Integer
  taskId          String?  @map("task_id")
  status          String?
  typeGenerate    String?  @map("type_generate")
  projectId       String   @map("project_id")
  userId          String   @map("user_id")
  prompt          String
  tokenUsed       Float    @map("token_used")
  ImageUsed       Int      @map("image_used")
  referenceImages String[] @default([]) @map("reference_images")
  resolution      String?
  ratio           String?
  generateAudio   Boolean? @default(false) @map("generate_audio")
  createdAt       DateTime @default(now()) @map("created_at")
  generateConfig  Json?    @map("generate_config") @db.JsonB
  project         Project  @relation(fields: [projectId], references: [id])
  users           users    @relation(fields: [userId], references: [userId])
  galleryId       String?  @map("gallary_id") @db.VarChar(100)
  usedCredit      Float?   @default(0) @map("used_credit")
  usedImage       Int?     @default(0) @map("used_image")
  // คอลัมน์ใหม่สำหรับแยกประเภทฟีเจอร์ — มี default + nullable เพื่อไม่ให้ insert เดิมพัง
  featureType     String   @default("chat") @map("feature_type") @db.VarChar(50)
  refFeatureId    String?  @map("ref_feature_id") @db.VarChar(100)

  @@map("log")

  // index ตาม source/improvements P1-5 (query จริงใน services)
  @@index([taskId])
  @@index([projectId, status, createdAt])
  @@index([userId, createdAt])
}

/// บทสนทนา/แคนวาสของ Workflow หนึ่งชุด (1 โปรเจกต์มีได้หลายชุด)
model WorkflowConversation {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project         @relation(fields: [projectId], references: [id])
  blocks  WorkflowBlock[]

  @@map("workflow_conversation")
}

/// หนึ่งบล็อก = หนึ่งงาน generate ภายใน Workflow conversation
model WorkflowBlock {
  id                     String   @id @default(uuid())
  workflowConversationId String   @map("workflow_conversation_id")
  // รายการ id ของบล็อกต้นทางที่นำ output มาเป็น input
  parentBlockIds         String[] @default([]) @map("parent_block_ids")
  type                   String   @db.VarChar(20) // "image" | "video"
  status                 String   @default("pending") @db.VarChar(20) // pending|processing|success|failed
  prompt                 String
  model                  String
  resolution             String
  // payload เต็มที่ส่งให้ GenerateService (ให้ตรงกับฟอร์มเดิมของ Gen Image/Video)
  generateConfig         Json?    @map("generate_config") @db.JsonB
  // ใช้ map บล็อก -> task ของ pipeline เดิม (สำหรับ reuse)
  taskId                 String?  @map("task_id")
  outputUrl              String?  @map("output_url")
  errorMessage           String?  @map("error_message")
  positionX              Float    @default(0) @map("position_x")
  positionY              Float    @default(0) @map("position_y")
  duration               Float? // วินาทีที่ใช้ในการ generate
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  conversation WorkflowConversation @relation(fields: [workflowConversationId], references: [id], onDelete: Cascade)

  @@map("workflow_block")
}

/// template (PromptGuide) ที่ project เลือกไว้แสดงบนจอ kiosk ของ Photo Event
model PhotoEventTemplate {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  promptGuideId Int      @map("prompt_guide_id")
  sortOrder     Int      @default(0) @map("sort_order")
  // ต่อท้าย textPrompt ตอน generate จาก event — null = ใช้ค่า default ใน code
  promptTail    String?  @map("prompt_tail") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  project     Project     @relation(fields: [projectId], references: [id])
  promptGuide PromptGuide @relation(fields: [promptGuideId], references: [id], onDelete: Cascade)

  @@unique([projectId, promptGuideId])
  @@map("photo_event_template")
}

/// layout การ์ดที่พิมพ์ของ Photo Event — project มีได้หลายแบบ แต่ active ได้ทีละ 1
model PhotoEventPrintTemplate {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(false) @map("is_active")
  // IPrintLayout ของ frontend (หน่วย mm) — validate ด้วย parsePrintLayout ก่อนเก็บ
  layout    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("photo_event_print_template")
}

/// ประกาศบนหน้า public (home/features/pricing) — super admin จัดการ, active ได้หลายชิ้นพร้อมกัน
model Announcement {
  id        String   @id @default(uuid())
  category  String   @db.VarChar(30) // PROMOTION | SYSTEM_UPDATE
  title     String   @db.VarChar(150)
  body      String?  @db.Text
  imageKey  String?  @map("image_key") @db.VarChar(255)
  isActive  Boolean  @default(false) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("announcement")
}

/// รูปที่ staff นำเข้าให้แขกเลือกบนจอ kiosk
model PhotoEventPhoto {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  organizationId String   @map("organization_id") @db.VarChar(50)
  userId         String   @map("user_id")
  imagePath      String   @map("image_path")
  imageName      String   @map("image_name")
  imageType      String   @map("image_type") @db.VarChar(50)
  imageSize      Int      @default(0) @map("image_size")
  status         String   @default("active") @db.VarChar(20) // active|deleted
  createdAt      DateTime @default(now()) @map("created_at")

  project     Project                @relation(fields: [projectId], references: [id])
  generations PhotoEventGeneration[]

  @@index([projectId, status])
  @@map("photo_event_photo")
}

/// หนึ่งครั้งที่กด generate บน kiosk — id ใช้เป็นลิงก์ share ใน QR code
model PhotoEventGeneration {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  photoId       String   @map("photo_id")
  promptGuideId Int      @map("prompt_guide_id")
  userId        String   @map("user_id")
  taskId        String   @unique @map("task_id")
  status        String   @default("pending") @db.VarChar(20) // pending|processing|success|failed
  progress      Int?
  // storage key เต็มของรูปผลลัพธ์ (presign ใหม่ทุกครั้งที่อ่าน)
  outputKey     String?  @map("output_key")
  galleryId     String?  @map("gallery_id")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  photo PhotoEventPhoto @relation(fields: [photoId], references: [id])

  @@index([projectId])
  @@index([photoId])
  @@map("photo_event_generation")
}

model groups {
  id          Int      @id @default(autoincrement())
  groupId     String   @unique @default(uuid()) @map("group_id") @db.VarChar(50)
  name        String   @db.VarChar(100)
  displayName String?  @map("display_name") @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles GroupRole[]
  users UserGroup[]
}

model role {
  id          Int      @id @default(autoincrement())
  roleId      String   @unique @default(uuid()) @map("role_id") @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  type        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  groups GroupRole[]
}

model GroupRole {
  id Int @id @default(autoincrement())

  groupId String @map("group_id") @db.VarChar(50)
  roleId  String @map("role_id") @db.VarChar(50)

  group groups @relation(fields: [groupId], references: [groupId])
  role  role   @relation(fields: [roleId], references: [roleId])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([groupId, roleId])
  @@map("group_role")
}

model UserGroup {
  id      Int    @id @default(autoincrement())
  userId  String @map("user_id") @db.VarChar(50)
  groupId String @map("group_id") @db.VarChar(50)
  users   users  @relation(fields: [userId], references: [userId])
  group   groups @relation(fields: [groupId], references: [groupId])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, groupId])
  @@map("user_group")
}

model MasterModelType {
  id              Int      @unique @default(autoincrement()) @map("id")
  name            String?  @map("name") @db.VarChar(150)
  modelType       String?  @map("model_type") @db.VarChar(150)
  type            String?  @map("type") @db.VarChar(150)
  description     String?  @map("description") @db.VarChar(150)
  isDefault       Boolean  @default(false) @map("is_default")
  modelDetails    Json?    @map("model_details")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")
  optionCode      String[] @default([]) @map("option_code")
  sendApi         String   @default("") @map("send_api") @db.Text
  sendConfig      Json?    @map("send_config")
  requestBodyMap  Json?    @map("request_body_map")
  taskPollApi     String?  @map("task_poll_api") @db.Text
  taskPollSec     Int      @default(10) @map("task_poll_sec") @db.Integer
  taskResponseMap Json?    @map("task_response_map")
  isActive        Boolean  @default(false) @map("is_active")
  provider        String?  @map("provider") @db.VarChar(50)
  iconUrl         String?  @map("icon_url") @db.Text

  @@map("master_model_type")
}

model MasterModelOption {
  id          String  @unique @default(uuid()) @map("id") @db.VarChar(50)
  optionCode  String  @unique @map("option_code") @db.VarChar(20) //code แสดง input
  avaliable   String  @unique @map("avaliable") @db.VarChar(20) //ชื่อตัวแปล
  description String? @unique @map("description") @db.VarChar(20)
  type        String  @map("type") @db.VarChar(150)

  @@map("master_model_option")
}

model GenerateImage {
  id        Int       @unique @default(autoincrement()) @map("id")
  fileName  String?   @map("file_name") @db.VarChar(150)
  filePath  String?   @map("file_path") @db.VarChar(150)
  fileType  String?   @map("file_type") @db.VarChar(150)
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @map("updated_at")

  @@map("generate_image")
}

model HistoryLogsImages {
  id        Int      @unique @default(autoincrement()) @map("id")
  userId    String?  @map("user_id") @db.VarChar(50)
  token     String?  @map("token") @db.VarChar(50)
  modelType String?  @map("model_type") @db.VarChar(150)
  imageId   String?  @map("image_id") @db.VarChar(150)
  status    String?  @map("status") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("history_logs_images")
}

model MasterDataConfigApi {
  id               Int      @unique @default(autoincrement()) @map("id")
  configType       String?  @map("config_type") @db.VarChar(150)
  authorization    String?  @map("authorization") @db.VarChar(150)
  apiCreateImage   String?  @map("api_create_image") @db.VarChar(250)
  apiCreateTaskVdo String?  @map("api_update_task_vdo") @db.VarChar(250)
  maxImage         Int?     @map("max_image") @db.Integer
  watermark        Boolean? @map("watermark") @db.Boolean
  stream           Boolean? @map("stream") @db.Boolean
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @map("updated_at")

  @@map("master_data_config_api")
}

model PromptGuide {
  id                  Int                  @unique @default(autoincrement()) @map("id")
  title               String?              @map("title") @db.VarChar(150)
  textPrompt          String?              @map("text_prompt") @db.Text
  description         String?              @map("description") @db.Text
  model               String?              @map("model") @db.VarChar(100)
  status              Boolean              @map("status") @db.Boolean
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @map("updated_at")
  promptGuideType     PromptGuideType?     @relation(fields: [promptGuideTypeId], references: [id])
  promptGuideTypeId   Int?                 @map("prompt_guide_type_id")
  organizationId      String?              @map("organization_id") @db.VarChar(50)
  generateType        String               @default("image") @map("generate_type") @db.VarChar(10) // image/video
  promptGuideImages   String[]             @default([]) @map("prompt_guide_images")
  /// uid ของ PromptGuideImage ที่เป็นผลลัพธ์ตัวอย่าง — แสดงเป็น showcase ไม่ถูกแนบตอน Use Template
  promptGuideResults  String[]             @default([]) @map("prompt_guide_results")
  photoEventTemplates PhotoEventTemplate[]

  @@map("prompt_guide")
}

model PromptGuideImage {
  id            Int      @id @default(autoincrement())
  uid           String   @unique @db.VarChar(50)
  userId        String   @map("user_id") @db.VarChar(50)
  index         Int      @default(0)
  imageName     String   @map("image_name") @db.VarChar(200)
  imagePath     String   @map("image_path") @db.VarChar(200)
  imageType     String   @map("image_type") @db.VarChar(50)
  imageSize     Int      @default(0) @map("image_size")
  generateType  String   @map("generate_type") @db.VarChar(50)
  status        String   @default("waiting") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  // promptGuide   PromptGuide? @relation(fields: [promptGuideId], references: [id])
  promptGuideId Int?     @map("prompt_guide_id") @db.Integer()

  @@map("prompt_guide_images")
}

model PromptGuideType {
  id             Int           @unique @default(autoincrement()) @map("id")
  title          String?       @map("title") @db.VarChar(150)
  status         Boolean       @map("status") @db.Boolean
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @map("updated_at")
  organizationId String?       @map("organization_id") @db.VarChar(50)
  promptGuide    PromptGuide[]
  generateType   String        @default("image") @map("generate_type") @db.VarChar(10) // image/video

  @@map("prompt_guide_type")
}

model OmnihumenTask {
  id            Int      @unique @default(autoincrement()) @map("id")
  uuid          String?  @default(uuid()) @map("uuid") @db.VarChar(50)
  status        Boolean  @map("status") @db.Boolean
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  taskId        String   @map("task_id") @db.VarChar(100)
  taskRequestId String?  @map("task_request_id") @db.VarChar(100)
  taskMessage   String?  @map("task_message") @db.VarChar(20)
  fileId        String?  @map("file_id") @db.VarChar(100)
  filePath      String?  @map("file_path") @db.Text
  fileOrgPath   String?  @map("file_org_path") @db.Text
  projectId     String   @map("project_id") @db.VarChar(100)
  userId        String?  @map("user_id") @db.VarChar(100)
  avatarName    String?  @map("avatar_name") @db.VarChar(150)
  prompt        String?  @map("prompt") @db.Text
